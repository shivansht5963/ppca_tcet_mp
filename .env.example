# .env — Never commit this file to Git!
# Step 1: Go to https://rapidapi.com/
# Step 2: Search "Indian Railways" → Subscribe to free plan (e.g. IRCTC API by ApiDojo)
# Step 3: Copy your key from the RapidAPI dashboard and paste below

RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=irctc1.p.rapidapi.com

DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string-before-production
